# ============================================================
# Huginn 数据统计分析智能体 — 环境变量配置
# 复制此文件为 .env 并填入你的 API Key
#   cp .env.example .env
# ============================================================

# DeepSeek API Key (必填)
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-key-here

# API 地址 (默认 DeepSeek, 可换成 OpenAI 兼容的任意服务)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 模型名称
# DeepSeek: deepseek-v4-pro / deepseek-v4-flash / deepseek-chat
# OpenAI:  gpt-4o / gpt-4o-mini
LLM_MODEL=deepseek-v4-pro

# ============================================================
# 可选配置 (全部有默认值, 不需要改)
# ============================================================
# LLM_MAX_RETRIES=3          # API 重试次数
# LLM_TEMPERATURE=0.1        # 输出温度 (0-1, 越低越稳定)
# TASK_MIN_COUNT=5           # 最少分析任务数
# OUTPUT_DIR=./outputs        # 结果输出目录
